@model Megdan.Web.ViewModels.AdminUpdateComplaintViewModel
@using Megdan.Web.Models.Enums
@using Megdan.Web.Helpers

@{
    ViewData["Title"] = "Complaint Details";

    string StatusClasses(ComplaintStatus status) => status switch
    {
        ComplaintStatus.Pending => "bg-amber-100 text-amber-800 border border-amber-200",
        ComplaintStatus.InProgress => "bg-sky-100 text-sky-800 border border-sky-200",
        ComplaintStatus.Resolved => "bg-emerald-100 text-emerald-800 border border-emerald-200",
        _ => "bg-stone-100 text-stone-700 border border-stone-200"
    };

    string PriorityClasses(ComplaintPriority priority) => priority switch
    {
        ComplaintPriority.Low => "bg-stone-100 text-stone-700 border border-stone-200",
        ComplaintPriority.Medium => "bg-yellow-100 text-yellow-800 border border-yellow-200",
        ComplaintPriority.High => "bg-orange-100 text-orange-800 border border-orange-200",
        ComplaintPriority.Urgent => "bg-rose-100 text-rose-800 border border-rose-200",
        _ => "bg-stone-100 text-stone-700 border border-stone-200"
    };
}

<div class="space-y-6">
    <div class="flex flex-wrap gap-3">
        <a asp-action="Index" asp-controller="Admin"
           class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-800 transition hover:border-stone-400 hover:bg-stone-50">
            Back to dashboard
        </a>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
        <div class="space-y-6">
            <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Complaint record</p>
                        <h1 class="mt-2 text-3xl font-black tracking-tight text-stone-900 sm:text-4xl">
                            @Model.Complaint.Title
                        </h1>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <span class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold @StatusClasses(Model.Complaint.Status)">
    @Model.Complaint.Status.ToDisplayString()
</span>
                        <span class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold @PriorityClasses(Model.Complaint.Priority)">
                            @Model.Complaint.Priority.ToDisplayString()
                        </span>
                    </div>
                </div>

                <dl class="mt-6 grid gap-4 sm:grid-cols-2">
                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">ID</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">@Model.Complaint.Id</dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Email</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">@Model.Complaint.CitizenEmail</dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Category</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">@(Model.Complaint.Category ?? "Not assigned")</dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Frustration</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">@(Model.Complaint.FrustrationLevel ?? "Not processed")</dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Address</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">@(Model.Complaint.Address ?? "Not provided")</dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Submitted</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">@Model.Complaint.CreatedAtUtc.ToLocalTime().ToString("f")</dd>
                    </div>
                </dl>

                <div class="mt-6 rounded-[1.5rem] border border-stone-200 bg-stone-50 p-5">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Description</p>
                    <p class="mt-3 text-sm leading-7 text-stone-700">
                        @Model.Complaint.Description
                    </p>
                </div>
            </section>

            @if (Model.Complaint.Images.Any())
            {
                <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Evidence</p>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Uploaded images</h2>

                    <div class="mt-6 grid gap-4 sm:grid-cols-2">
                        @foreach (var image in Model.Complaint.Images)
                        {
                            <a href="@image.FilePath" target="_blank" rel="noopener noreferrer"
                               class="group overflow-hidden rounded-[1.5rem] border border-stone-200 bg-stone-50">
                                <img src="@image.FilePath"
                                     alt="Complaint image"
                                     class="h-64 w-full object-cover transition duration-300 group-hover:scale-[1.02]" />
                            </a>
                        }
                    </div>
                </section>
            }

            @if (Model.Complaint.Latitude.HasValue && Model.Complaint.Longitude.HasValue)
            {
                <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Location</p>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Submitted pin</h2>

                    <div class="mt-5 overflow-hidden rounded-[1.5rem] border border-stone-200">
                        <div id="tracking-map" class="h-[350px] w-full"></div>
                    </div>
                </section>
            }

            <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Case history</p>
                <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Comments and updates</h2>

                @if (Model.Complaint.Comments.Any())
                {
                    <div class="mt-6 space-y-4">
                        @foreach (var comment in Model.Complaint.Comments.OrderBy(c => c.CreatedAtUtc))
                        {
                            var isAdmin = string.Equals(comment.AuthorType, "Admin", StringComparison.OrdinalIgnoreCase);

                            <article class="rounded-[1.5rem] border @(isAdmin ? "border-brand-200 bg-brand-50/60" : "border-stone-200 bg-stone-50") p-4 sm:p-5">
                                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(isAdmin ? "bg-brand-100 text-brand-800" : "bg-stone-200 text-stone-700")">
                                                @comment.AuthorType
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(comment.AuthorName))
                                            {
                                                <span class="text-sm font-medium text-stone-700">@comment.AuthorName</span>
                                            }
                                        </div>
                                    </div>

                                    <p class="text-xs font-medium uppercase tracking-[0.14em] text-stone-500">
                                        @comment.CreatedAtUtc.ToLocalTime().ToString("g")
                                    </p>
                                </div>

                                <p class="mt-4 text-sm leading-7 text-stone-700">
                                    @comment.Content
                                </p>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="mt-6 rounded-[1.5rem] border border-dashed border-stone-300 bg-stone-50 p-6 text-sm text-stone-500">
                        No comments yet.
                    </div>
                }
            </section>

            @if (Model.Complaint.Feedback != null)
            {
                <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Citizen response</p>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Citizen feedback</h2>

                    <div class="mt-6 grid gap-4 sm:grid-cols-3">
                        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Rating</p>
                            <p class="mt-2 text-lg font-bold text-stone-900">@Model.Complaint.Feedback.Rating / 5</p>
                        </div>

                        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:col-span-2">
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Comment</p>
                            <p class="mt-2 text-sm leading-7 text-stone-700">
                                @(Model.Complaint.Feedback.Comment ?? "No comment")
                            </p>
                        </div>
                    </div>

                    <p class="mt-4 text-sm text-stone-500">
                        Submitted on @Model.Complaint.Feedback.SubmittedAtUtc.ToLocalTime().ToString("f")
                    </p>
                </section>
            }
        </div>

        <aside>
            <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Admin action</p>
                <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Update complaint</h2>

                <form asp-action="Update" asp-controller="Admin" method="post" class="mt-6 space-y-5">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

                    <div>
                        <label asp-for="Category" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                        <input asp-for="Category"
                               class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
                        <span asp-validation-for="Category" class="mt-2 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Priority" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                        <select asp-for="Priority"
                                class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                                asp-items="Html.GetEnumSelectList<ComplaintPriority>()"></select>
                        <span asp-validation-for="Priority" class="mt-2 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Status" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                        <select asp-for="Status"
                                class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                                asp-items="Html.GetEnumSelectList<ComplaintStatus>()"></select>
                        <span asp-validation-for="Status" class="mt-2 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="AdminComment" class="mb-2 block text-sm font-semibold text-stone-800">Admin Comment</label>
                        <textarea asp-for="AdminComment"
                                  rows="5"
                                  class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"></textarea>
                        <span asp-validation-for="AdminComment" class="mt-2 block text-sm text-rose-600"></span>
                    </div>

                    <button type="submit"
                            class="inline-flex w-full items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                        Save changes
                    </button>
                </form>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.Complaint.Latitude.HasValue && Model.Complaint.Longitude.HasValue)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
              integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
              crossorigin="" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
                crossorigin=""></script>

        <script>
            const complaintLat = @Model.Complaint.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const complaintLng = @Model.Complaint.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

            const map = L.map('tracking-map').setView([complaintLat, complaintLng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.marker([complaintLat, complaintLng])
                .addTo(map)
                .bindPopup('Complaint location')
                .openPopup();
        </script>
    }
}
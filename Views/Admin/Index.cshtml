@model Megdan.Web.ViewModels.AdminComplaintListViewModel
@using Megdan.Web.Models.Enums
@using Megdan.Web.Helpers

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="space-y-6">
    @if (TempData["ImportMessage"] != null)
    {
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            @TempData["ImportMessage"]
        </div>
    }

    @if (TempData["ImportErrors"] != null)
    {
        var rawErrors = TempData["ImportErrors"]?.ToString() ?? "";
        var importErrors = rawErrors.Split(" || ", StringSplitOptions.RemoveEmptyEntries);

        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            <strong>Some rows were skipped:</strong>
            <ul class="mt-2 list-disc space-y-1 pl-5">
                @foreach (var error in importErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Administration</p>
                <h1 class="mt-2 text-3xl font-black tracking-tight text-stone-900 sm:text-4xl">
                    Admin dashboard
                </h1>
                <p class="mt-4 max-w-3xl text-sm leading-7 text-stone-600 sm:text-base">
                    Review complaints, apply filters, monitor urgent cases, and export or import operational data.
                </p>
            </div>

            <div class="flex flex-wrap gap-3">
                <a asp-action="Import" asp-controller="Admin"
                   class="inline-flex items-center justify-center rounded-full border border-brand-300 bg-brand-50 px-5 py-3 text-sm font-semibold text-brand-800 transition hover:bg-brand-100">
                    Import CSV
                </a>

                <a asp-action="ExportCsv"
                   asp-route-category="@Model.Category"
                   asp-route-priority="@Model.Priority"
                   asp-route-status="@Model.Status"
                   asp-route-citizenEmail="@Model.CitizenEmail"
                   asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                   asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-800 transition hover:border-stone-400 hover:bg-stone-50">
                    Export CSV
                </a>

                <a asp-action="ExportExcel"
                   asp-route-category="@Model.Category"
                   asp-route-priority="@Model.Priority"
                   asp-route-status="@Model.Status"
                   asp-route-citizenEmail="@Model.CitizenEmail"
                   asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                   asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-sortDirection="@Model.SortDirection"
                   class="inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                    Export Excel
                </a>
            </div>
        </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <div class="rounded-[1.75rem] border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Total</p>
            <p class="mt-3 text-3xl font-black tracking-tight text-stone-900">@Model.TotalCount</p>
        </div>

        <div class="rounded-[1.75rem] border border-amber-200 bg-amber-50 p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-700">Pending</p>
            <p class="mt-3 text-3xl font-black tracking-tight text-amber-900">@Model.PendingCount</p>
        </div>

        <div class="rounded-[1.75rem] border border-sky-200 bg-sky-50 p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-700">In progress</p>
            <p class="mt-3 text-3xl font-black tracking-tight text-sky-900">@Model.InProgressCount</p>
        </div>

        <div class="rounded-[1.75rem] border border-emerald-200 bg-emerald-50 p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-700">Resolved</p>
            <p class="mt-3 text-3xl font-black tracking-tight text-emerald-900">@Model.ResolvedCount</p>
        </div>

        <div class="rounded-[1.75rem] border border-rose-200 bg-rose-50 p-5 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-rose-700">Urgent</p>
            <p class="mt-3 text-3xl font-black tracking-tight text-rose-900">@Model.UrgentCount</p>
        </div>
    </section>

    <section class="grid gap-6 xl:grid-cols-2">
        <div class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Status distribution</p>
            <h2 class="mt-2 text-xl font-bold tracking-tight text-stone-900">Status overview</h2>
            <div class="mt-6 h-[320px]">
                <canvas id="statusChart"></canvas>
            </div>
        </div>

        <div class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Priority distribution</p>
            <h2 class="mt-2 text-xl font-bold tracking-tight text-stone-900">Priority overview</h2>
            <div class="mt-6 h-[320px]">
                <canvas id="priorityChart"></canvas>
            </div>
        </div>
    </section>

    <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="mb-6">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Filters</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Refine results</h2>
        </div>

        <form method="get" asp-action="Index" asp-controller="Admin" class="grid gap-5 lg:grid-cols-12">
            <div class="lg:col-span-3">
                <label asp-for="Category" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                <input asp-for="Category"
                       class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
            </div>

            <div class="lg:col-span-2">
                <label asp-for="Priority" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                <select asp-for="Priority"
                        class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                        asp-items="Html.GetEnumSelectList<ComplaintPriority>()">
                    <option value="">All</option>
                </select>
            </div>

            <div class="lg:col-span-2">
                <label asp-for="Status" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                <select asp-for="Status"
                        class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100"
                        asp-items="Html.GetEnumSelectList<ComplaintStatus>()">
                    <option value="">All</option>
                </select>
            </div>

            <div class="lg:col-span-3">
                <label asp-for="CitizenEmail" class="mb-2 block text-sm font-semibold text-stone-800">Citizen Email</label>
                <input asp-for="CitizenEmail"
                       class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
            </div>

            <div class="lg:col-span-2">
                <label asp-for="FromDate" class="mb-2 block text-sm font-semibold text-stone-800">From Date</label>
                <input asp-for="FromDate" type="date"
                       class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
            </div>

            <div class="lg:col-span-2">
                <label asp-for="ToDate" class="mb-2 block text-sm font-semibold text-stone-800">To Date</label>
                <input asp-for="ToDate" type="date"
                       class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
            </div>

            <div class="lg:col-span-3">
                <label asp-for="SortBy" class="mb-2 block text-sm font-semibold text-stone-800">Sort By</label>
                <select asp-for="SortBy"
                        class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100">
                    <option value="">Created Date</option>
                    <option value="CreatedAt">Created Date</option>
                    <option value="Priority">Priority</option>
                    <option value="Status">Status</option>
                    <option value="Category">Category</option>
                    <option value="Comments">Comments</option>
                </select>
            </div>

            <div class="lg:col-span-2">
                <label asp-for="SortDirection" class="mb-2 block text-sm font-semibold text-stone-800">Order</label>
                <select asp-for="SortDirection"
                        class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100">
                    <option value="desc">Descending</option>
                    <option value="asc">Ascending</option>
                </select>
            </div>

            <div class="lg:col-span-12 flex flex-wrap gap-3 pt-2">
                <button type="submit"
                        class="inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                    Apply filters
                </button>

                <a asp-action="Index" asp-controller="Admin"
                   class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-800 transition hover:border-stone-400 hover:bg-stone-50">
                    Clear
                </a>
            </div>
        </form>
    </section>

    <section class="overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-sm">
        <div class="border-b border-stone-200 px-6 py-4 sm:px-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Complaint records</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Filtered complaints</h2>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-stone-200 text-left">
                <thead class="bg-stone-50">
                    <tr class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">
                        <th class="px-6 py-4">ID</th>
                        <th class="px-6 py-4">Title</th>
                        <th class="px-6 py-4">Category</th>
                        <th class="px-6 py-4">Priority</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Submitted</th>
                        <th class="px-6 py-4">Images</th>
                        <th class="px-6 py-4">Comments</th>
                        <th class="px-6 py-4"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-stone-200 bg-white">
                    @if (Model.Complaints.Any())
                    {
                        @foreach (var item in Model.Complaints)
                        {
                            <tr class="align-top text-sm text-stone-700">
                                <td class="px-6 py-4 font-semibold text-stone-900">@item.Id</td>
                                <td class="px-6 py-4">
                                    <div class="max-w-[240px] font-medium text-stone-900">@item.Title</div>
                                </td>
                                <td class="px-6 py-4">@(item.Category ?? "-")</td>
                                <td class="px-6 py-4">@item.Priority.ToDisplayString()</td>
                                <td class="px-6 py-4">@item.Status.ToDisplayString()</td>
                                <td class="px-6 py-4">@item.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td class="px-6 py-4">@(item.HasImages ? "Yes" : "No")</td>
                                <td class="px-6 py-4">@item.CommentCount</td>
                                <td class="px-6 py-4">
                                    <a asp-action="Details"
                                       asp-controller="Admin"
                                       asp-route-id="@item.Id"
                                       class="inline-flex items-center justify-center rounded-full border border-brand-300 bg-brand-50 px-4 py-2 text-xs font-semibold text-brand-800 transition hover:bg-brand-100">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-10 text-center text-sm text-stone-500">
                                No complaints match the current filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const statusLabels = @Html.Raw(Model.StatusLabelsJson);
        const statusValues = @Html.Raw(Model.StatusValuesJson);
        const priorityLabels = @Html.Raw(Model.PriorityLabelsJson);
        const priorityValues = @Html.Raw(Model.PriorityValuesJson);

        new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
        labels: statusLabels,
        datasets: [{
        data: statusValues,
        backgroundColor: ['#f59e0b', '#0ea5e9', '#10b981']
        }]
        },
        options: {
        maintainAspectRatio: false,
        plugins: {
        legend: {
        position: 'bottom'
        }
        }
        }
        });

        new Chart(document.getElementById('priorityChart'), {
        type: 'bar',
        data: {
        labels: priorityLabels,
        datasets: [{
        label: 'Complaints',
        data: priorityValues,
        backgroundColor: ['#78716c', '#f59e0b', '#f97316', '#e11d48']
        }]
        },
        options: {
        maintainAspectRatio: false,
        responsive: true,
        plugins: {
        legend: {
        display: false
        }
        },
        scales: {
        y: {
        beginAtZero: true,
        ticks: { precision: 0 }
        }
        }
        }
        });
    </script>
}
@model Megdan.Web.ViewModels.UserComplaintsViewModel

@{
    ViewData["Title"] = "Your Complaints";
}

<section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Email access</p>
            <h1 class="mt-2 text-3xl font-black tracking-tight text-stone-900 sm:text-4xl">
                Your complaints
            </h1>
            <p class="mt-4 text-sm leading-7 text-stone-600 sm:text-base">
                This page shows complaints associated with <span class="font-semibold text-stone-900">@Model.Email</span>.
            </p>
        </div>

        <a asp-controller="Complaints"
           asp-action="Track"
           class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-800 transition hover:border-stone-400 hover:bg-stone-50">
            Back to tracking access
        </a>
    </div>

    @if (Model.Complaints.Any())
    {
        <div class="mt-8 grid gap-4">
            @foreach (var complaint in Model.Complaints)
            {
                <article class="rounded-[1.75rem] border border-stone-200 bg-stone-50 p-5">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="inline-flex rounded-full bg-stone-200 px-2.5 py-1 text-xs font-semibold text-stone-700">
                                    #@complaint.ComplaintId
                                </span>
                                <span class="inline-flex rounded-full bg-brand-100 px-2.5 py-1 text-xs font-semibold text-brand-800">
                                    @complaint.Status
                                </span>
                            </div>

                            <h2 class="mt-3 text-xl font-bold tracking-tight text-stone-900">
                                @complaint.Title
                            </h2>

                            <dl class="mt-4 grid gap-3 sm:grid-cols-3">
                                <div>
                                    <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Priority</dt>
                                    <dd class="mt-1 text-sm font-medium text-stone-900">@complaint.Priority</dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Category</dt>
                                    <dd class="mt-1 text-sm font-medium text-stone-900">@(complaint.Category ?? "Not assigned")</dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Submitted</dt>
                                    <dd class="mt-1 text-sm font-medium text-stone-900">@complaint.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
                                </div>
                            </dl>

                            <p class="mt-4 text-sm text-stone-600">
                                @(string.IsNullOrWhiteSpace(complaint.Address) ? "No address provided" : complaint.Address)
                            </p>
                        </div>

                        <div class="shrink-0">
                            @if (!string.IsNullOrWhiteSpace(complaint.TrackingToken))
                            {
                                <a asp-controller="Complaints"
                                   asp-action="Track"
                                   asp-route-token="@complaint.TrackingToken"
                                   class="inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                                    Open complaint
                                </a>
                            }
                            else
                            {
                                <span class="inline-flex rounded-full bg-stone-200 px-3 py-2 text-xs font-semibold text-stone-600">
                                    No active tracking link
                                </span>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="mt-8 rounded-[1.75rem] border border-dashed border-stone-300 bg-stone-50 p-6 text-sm text-stone-500">
            No complaints were found for this email.
        </div>
    }
</section>
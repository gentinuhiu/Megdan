@model Megdan.Web.ViewModels.RequestComplaintAccessViewModel

@{
    ViewData["Title"] = "Track Complaint";
}

<div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
    <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Complaint tracking</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight text-stone-900 sm:text-4xl">
            Access your complaint
        </h1>
        <p class="mt-4 text-sm leading-7 text-stone-600 sm:text-base">
            If you opened the page directly without a tracking token, you can request a secure access link using the same email address you used when submitting the complaint.
        </p>

        <div class="mt-8 rounded-[1.5rem] border border-stone-200 bg-stone-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">How it works</p>
            <ol class="mt-4 space-y-3 text-sm leading-6 text-stone-600">
                <li><span class="font-semibold text-stone-900">1.</span> Enter the email address associated with your complaint.</li>
                <li><span class="font-semibold text-stone-900">2.</span> We send a secure access link to that address.</li>
                <li><span class="font-semibold text-stone-900">3.</span> Open the emailed link to see all complaints connected to your email.</li>
            </ol>
        </div>
    </section>

    <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Forgot your token?</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Request access by email</h2>
        <p class="mt-3 text-sm leading-6 text-stone-600">
            We will email you a temporary link if complaints exist for that address.
        </p>

        <form asp-action="RequestComplaintAccess" asp-controller="Complaints" method="post" class="mt-6 space-y-5">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

            <div>
                <label asp-for="Email" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                <input asp-for="Email"
                       class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
                <span asp-validation-for="Email" class="mt-2 block text-sm text-rose-600"></span>
            </div>

            <button type="submit"
                    class="inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                Email me an access link
            </button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
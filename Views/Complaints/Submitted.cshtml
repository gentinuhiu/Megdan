@model Megdan.Web.Models.Complaint

@{
    ViewData["Title"] = "Complaint Submitted";
    var token = Model.TrackingTokens.FirstOrDefault()?.Token;
}

<section class="mx-auto max-w-3xl rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8 lg:p-10">
    <div class="flex items-start gap-4">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700">
            <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </div>

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-700">Submission complete</p>
            <h1 class="mt-2 text-3xl font-black tracking-tight text-stone-900 sm:text-4xl">
                Complaint submitted successfully
            </h1>
            <p class="mt-4 text-sm leading-7 text-stone-600 sm:text-base">
                Your complaint has been recorded. Keep your tracking link so you can follow progress, add comments, and leave feedback if the case is resolved later.
            </p>
        </div>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Complaint ID</p>
            <p class="mt-2 text-lg font-bold text-stone-900">@Model.Id</p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Status</p>
            <p class="mt-2 text-lg font-bold text-stone-900">@Model.Status</p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Category</p>
            <p class="mt-2 text-sm font-medium text-stone-900">@(Model.Category ?? "Not assigned")</p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Priority</p>
            <p class="mt-2 text-sm font-medium text-stone-900">@Model.Priority</p>
        </div>
    </div>

    @if (TempData["AiWarning"] != null)
    {
        <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            @TempData["AiWarning"]
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(token))
    {
        <div class="mt-6 rounded-[1.75rem] border border-brand-200 bg-brand-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Tracking link</p>
            <p class="mt-3 text-sm leading-6 text-stone-700">
                Use this page to review updates, post follow-up comments, and see the submitted map location.
            </p>

            <div class="mt-5">
                <a asp-controller="Complaints"
                   asp-action="Track"
                   asp-route-token="@token"
                   class="inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                    Open complaint tracking page
                </a>
            </div>
        </div>
    }
</section>
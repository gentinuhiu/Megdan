@model Megdan.Web.ViewModels.TrackComplaintViewModel

@{
    ViewData["Title"] = "Track Complaint";

    string StatusClasses(Megdan.Web.Models.Enums.ComplaintStatus status) => status switch
    {
        Megdan.Web.Models.Enums.ComplaintStatus.Pending => "bg-amber-100 text-amber-800 border border-amber-200",
        Megdan.Web.Models.Enums.ComplaintStatus.InProgress => "bg-sky-100 text-sky-800 border border-sky-200",
        Megdan.Web.Models.Enums.ComplaintStatus.Resolved => "bg-emerald-100 text-emerald-800 border border-emerald-200",
        _ => "bg-stone-100 text-stone-700 border border-stone-200"
    };

    string PriorityClasses(Megdan.Web.Models.Enums.ComplaintPriority priority) => priority switch
    {
        Megdan.Web.Models.Enums.ComplaintPriority.Low => "bg-stone-100 text-stone-700 border border-stone-200",
        Megdan.Web.Models.Enums.ComplaintPriority.Medium => "bg-yellow-100 text-yellow-800 border border-yellow-200",
        Megdan.Web.Models.Enums.ComplaintPriority.High => "bg-orange-100 text-orange-800 border border-orange-200",
        Megdan.Web.Models.Enums.ComplaintPriority.Urgent => "bg-rose-100 text-rose-800 border border-rose-200",
        _ => "bg-stone-100 text-stone-700 border border-stone-200"
    };
}

<div class="space-y-6">
    <section class="overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-sm">
        <div class="grid gap-8 px-6 py-8 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:px-10 lg:py-10">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Complaint tracking</p>
                <h1 class="mt-3 text-3xl font-black tracking-tight text-stone-900 sm:text-4xl">
                    @Model.Complaint.Title
                </h1>

                <p class="mt-4 max-w-3xl text-sm leading-7 text-stone-600 sm:text-base">
                    @Model.Complaint.Description
                </p>

                <dl class="mt-6 grid gap-4 sm:grid-cols-2">
                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Submitted</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">
                            @Model.Complaint.CreatedAtUtc.ToLocalTime().ToString("f")
                        </dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Address</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">
                            @(Model.Complaint.Address ?? "Not provided")
                        </dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Category</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">
                            @(Model.Complaint.Category ?? "Not assigned yet")
                        </dd>
                    </div>

                    <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Tracking access</dt>
                        <dd class="mt-2 text-sm font-medium text-stone-900">
                            Secure token-based link
                        </dd>
                    </div>
                </dl>
            </div>

            <aside class="flex flex-col gap-4 rounded-[1.75rem] border border-stone-200 bg-stone-50 p-5">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Current status</p>
                    <div class="mt-3 flex flex-wrap gap-3">
                        <span class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold @StatusClasses(Model.Complaint.Status)">
                            @Model.Complaint.Status
                        </span>
                        <span class="inline-flex items-center rounded-full px-3 py-1.5 text-xs font-semibold @PriorityClasses(Model.Complaint.Priority)">
                            @Model.Complaint.Priority priority
                        </span>
                    </div>
                </div>

                <div class="rounded-2xl bg-white p-4 ring-1 ring-stone-200">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">What you can do here</p>
                    <ul class="mt-3 space-y-3 text-sm leading-6 text-stone-600">
                        <li>Review status updates and comments from the municipality.</li>
                        <li>Add a follow-up comment if you have more information.</li>
                        <li>Leave feedback after the complaint is marked resolved.</li>
                    </ul>
                </div>

                @if (Model.Complaint.Status == Megdan.Web.Models.Enums.ComplaintStatus.Resolved)
                {
                    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800">
                        This complaint has been marked as resolved. Feedback is available below.
                    </div>
                }
                else
                {
                    <div class="rounded-2xl border border-stone-200 bg-white p-4 text-sm text-stone-600">
                        Updates will appear here as administrators review and process the complaint.
                    </div>
                }
            </aside>
        </div>
    </section>

    @if (Model.Complaint.Images.Any())
    {
        <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex items-end justify-between gap-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Submitted evidence</p>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Images</h2>
                </div>
                <p class="text-sm text-stone-500">@Model.Complaint.Images.Count image(s)</p>
            </div>

            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var image in Model.Complaint.Images)
                {
                    <a href="@image.FilePath" target="_blank" rel="noopener noreferrer"
                       class="group overflow-hidden rounded-[1.5rem] border border-stone-200 bg-stone-50">
                        <img src="@image.FilePath"
                             alt="Complaint image"
                             class="h-64 w-full object-cover transition duration-300 group-hover:scale-[1.02]" />
                    </a>
                }
            </div>
        </section>
    }

    <section class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex items-end justify-between gap-4">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Case activity</p>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Updates and comments</h2>
                </div>
            </div>

            @if (Model.Complaint.Comments.Any())
            {
                <div class="mt-6 space-y-4">
                    @foreach (var comment in Model.Complaint.Comments.OrderBy(c => c.CreatedAtUtc))
                    {
                        var isAdmin = string.Equals(comment.AuthorType, "Admin", StringComparison.OrdinalIgnoreCase);

                        <article class="rounded-[1.5rem] border @(isAdmin ? "border-brand-200 bg-brand-50/60" : "border-stone-200 bg-stone-50") p-4 sm:p-5">
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold @(isAdmin ? "bg-brand-100 text-brand-800" : "bg-stone-200 text-stone-700")">
                                            @comment.AuthorType
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(comment.AuthorName))
                                        {
                                            <span class="text-sm font-medium text-stone-700">@comment.AuthorName</span>
                                        }
                                    </div>
                                </div>

                                <p class="text-xs font-medium uppercase tracking-[0.14em] text-stone-500">
                                    @comment.CreatedAtUtc.ToLocalTime().ToString("g")
                                </p>
                            </div>

                            <p class="mt-4 text-sm leading-7 text-stone-700">
                                @comment.Content
                            </p>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="mt-6 rounded-[1.5rem] border border-dashed border-stone-300 bg-stone-50 p-6 text-sm text-stone-500">
                    No comments yet.
                </div>
            }
        </div>

        <div class="space-y-6">
            @if (Model.Complaint.Latitude.HasValue && Model.Complaint.Longitude.HasValue)
            {
                <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Submitted location</p>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Map pin</h2>
                    <p class="mt-3 text-sm leading-6 text-stone-600">
                        This is the location that was submitted with the complaint.
                    </p>

                    <div class="mt-5 overflow-hidden rounded-[1.5rem] border border-stone-200">
                        <div id="tracking-map" class="h-[350px] w-full"></div>
                    </div>

                    <div class="mt-4 grid gap-3 sm:grid-cols-2">
                        <div class="rounded-2xl bg-stone-50 p-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Latitude</p>
                            <p class="mt-2 text-sm font-medium text-stone-900">@Model.Complaint.Latitude.Value</p>
                        </div>
                        <div class="rounded-2xl bg-stone-50 p-4">
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Longitude</p>
                            <p class="mt-2 text-sm font-medium text-stone-900">@Model.Complaint.Longitude.Value</p>
                        </div>
                    </div>
                </section>
            }

            <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Citizen follow-up</p>
                <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Add comment</h2>
                <p class="mt-3 text-sm leading-6 text-stone-600">
                    Use this form to add extra details or provide a follow-up note for administrators.
                </p>

                <form asp-action="AddCitizenComment" asp-controller="Complaints" method="post" class="mt-6 space-y-4">
                    @Html.AntiForgeryToken()
                    <input asp-for="NewComment.Token" type="hidden" value="@Model.Token" />

                    <div>
                        <label asp-for="NewComment.Content" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                        <textarea asp-for="NewComment.Content"
                                  rows="5"
                                  class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"></textarea>
                        <span asp-validation-for="NewComment.Content" class="mt-2 block text-sm text-rose-600"></span>
                    </div>

                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                        Post comment
                    </button>
                </form>
            </section>
        </div>
    </section>

    @if (Model.CanSubmitFeedback)
    {
        <section class="rounded-[2rem] border border-emerald-200 bg-emerald-50/60 p-6 shadow-sm sm:p-8">
            <div class="max-w-3xl">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-700">Resolution feedback</p>
                <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Leave feedback</h2>
                <p class="mt-3 text-sm leading-6 text-stone-700">
                    Your complaint has been resolved. You can rate the experience and leave an optional comment.
                </p>
            </div>

            <form asp-action="SubmitFeedback" asp-controller="Complaints" method="post" class="mt-6 grid gap-4 lg:max-w-3xl">
                @Html.AntiForgeryToken()
                <input asp-for="NewFeedback.Token" type="hidden" value="@Model.Token" />

                <div>
                    <label asp-for="NewFeedback.Rating" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                    <select asp-for="NewFeedback.Rating"
                            class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition focus:border-brand-500 focus:ring-4 focus:ring-brand-100">
                        <option value="">Select a rating</option>
                        <option value="1">1 - Very poor</option>
                        <option value="2">2 - Poor</option>
                        <option value="3">3 - Average</option>
                        <option value="4">4 - Good</option>
                        <option value="5">5 - Excellent</option>
                    </select>
                    <span asp-validation-for="NewFeedback.Rating" class="mt-2 block text-sm text-rose-600"></span>
                </div>

                <div>
                    <label asp-for="NewFeedback.Comment" class="mb-2 block text-sm font-semibold text-stone-800"></label>
                    <textarea asp-for="NewFeedback.Comment"
                              rows="5"
                              class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100"></textarea>
                    <span asp-validation-for="NewFeedback.Comment" class="mt-2 block text-sm text-rose-600"></span>
                </div>

                <button type="submit"
                        class="inline-flex w-fit items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
                    Submit feedback
                </button>
            </form>
        </section>
    }
    else if (Model.Complaint.Feedback != null)
    {
        <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Resolution feedback</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Submitted feedback</h2>

            <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Rating</p>
                    <p class="mt-2 text-lg font-bold text-stone-900">@Model.Complaint.Feedback.Rating / 5</p>
                </div>

                <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:col-span-2">
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Comment</p>
                    <p class="mt-2 text-sm leading-7 text-stone-700">
                        @(Model.Complaint.Feedback.Comment ?? "No comment")
                    </p>
                </div>
            </div>

            <p class="mt-4 text-sm text-stone-500">
                Submitted on @Model.Complaint.Feedback.SubmittedAtUtc.ToLocalTime().ToString("f")
            </p>
        </section>
    }
    else if (Model.Complaint.Status != Megdan.Web.Models.Enums.ComplaintStatus.Resolved)
    {
        <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Resolution feedback</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Feedback</h2>
            <p class="mt-3 text-sm leading-6 text-stone-600">
                Feedback becomes available after the complaint is marked as resolved.
            </p>
        </section>
    }

    <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-stone-500">Lost access link?</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-stone-900">Request access to all your complaints</h2>
    <p class="mt-3 text-sm leading-6 text-stone-600">
        If you no longer have the original tracking link, enter your email address and we will send a secure access link for your complaint list.
    </p>

    <form asp-action="RequestComplaintAccess" asp-controller="Complaints" method="post" class="mt-6 grid gap-4 lg:max-w-2xl">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="EmailAccessRequest.Email" class="mb-2 block text-sm font-semibold text-stone-800"></label>
            <input asp-for="EmailAccessRequest.Email"
                   class="w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-brand-500 focus:ring-4 focus:ring-brand-100" />
            <span asp-validation-for="EmailAccessRequest.Email" class="mt-2 block text-sm text-rose-600"></span>
        </div>

        <button type="submit"
                class="inline-flex w-fit items-center justify-center rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-800 transition hover:border-stone-400 hover:bg-stone-50">
            Email access link
        </button>
    </form>
</section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.Complaint.Latitude.HasValue && Model.Complaint.Longitude.HasValue)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
              integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
              crossorigin="" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
                crossorigin=""></script>

        <script>
            const complaintLat = @Model.Complaint.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const complaintLng = @Model.Complaint.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

            const map = L.map('tracking-map').setView([complaintLat, complaintLng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.marker([complaintLat, complaintLng])
                .addTo(map)
                .bindPopup('Complaint location')
                .openPopup();
        </script>
    }
}

